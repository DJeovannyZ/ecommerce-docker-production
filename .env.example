# =============================================================================
# Variables de entorno del ecosistema (docker compose)
# =============================================================================
# Copia este archivo como .env:
#   cp .env.example .env
#
# Los valores por defecto permiten un arranque local inmediato. En produccion
# debes reemplazar credenciales y secretos antes de desplegar.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
APP_NAME="E-commerce API"
# URL publica de la API (usada por Swagger para generar enlaces absolutos).
API_URL=http://localhost:8000
# URL publica del frontend (metadata SEO y retornos de Stripe).
FRONTEND_URL=http://localhost:3000
SITE_NAME="Web Vitals Store"
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Seguridad de la API
# -----------------------------------------------------------------------------
# Dejar vacios para que el entrypoint genere valores efimeros de demo.
# En produccion genera valores estables y guardalos fuera del repositorio:
#   APP_KEY:    docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#   JWT_SECRET: openssl rand -base64 48
APP_KEY=
JWT_SECRET=

# -----------------------------------------------------------------------------
# Base de datos MySQL (uso interno; no se publica en el host)
# -----------------------------------------------------------------------------
MYSQL_VERSION=8.0
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

# -----------------------------------------------------------------------------
# Puertos publicados en el host
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
# La API se publica solo en loopback (Swagger y pruebas locales).
API_PORT=8000

# -----------------------------------------------------------------------------
# Imagenes
# -----------------------------------------------------------------------------
# Etiqueta comun para las imagenes construidas (api/frontend).
IMAGE_TAG=local
# Versiones de build (ver README: se desvian de la consigna por compatibilidad
# con los lockfiles del proyecto).
NODE_VERSION=22
PHP_VERSION=8.4

# -----------------------------------------------------------------------------
# Datos de demostracion
# -----------------------------------------------------------------------------
# Ejecuta migraciones + seeders al arrancar (catalogo y usuario admin).
# Ponlo en false en produccion.
RUN_SEEDER=true

# -----------------------------------------------------------------------------
# Stripe (opcional)
# -----------------------------------------------------------------------------
# Sin claves, el checkout del frontend funciona en modo demo.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
TAX_RATE=0

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# true solo cuando el sitio se sirve por HTTPS.
SESSION_COOKIE_SECURE=false
# Si la API no tiene Stripe configurado, continuar a la pantalla de exito demo.
DEMO_CHECKOUT_FALLBACK=true
