# =============================================================================
# Frontend Next.js - entorno local (sin Docker)
# =============================================================================
# Para ejecutar el ecosistema completo con Docker usa el `.env.example` de la
# raiz del repositorio.
#
#   cp .env.example .env.local
#   pnpm install
#   pnpm dev
# =============================================================================

# BASE_URL de la API (host + puerto, sin path).
# Local con `php artisan serve`:
API_BASE_URL=http://localhost:8000

# Prefijo de versionado de la API.
API_PREFIX=/api/v1

# Timeout (ms) de cada peticion al API.
API_TIMEOUT_MS=8000

# URL publica del frontend (metadata/SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre visible de la tienda.
NEXT_PUBLIC_SITE_NAME=Web Vitals Store

# true solo cuando el sitio se sirve por HTTPS.
SESSION_COOKIE_SECURE=false

# Continuar al checkout demo si la API no tiene Stripe configurado.
DEMO_CHECKOUT_FALLBACK=true
